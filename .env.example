# This file mirrors Lad's actual defaults and is checked against config.py by
# tests/test_docs_match_config_unittest.py. Every assigned value here must equal the
# real default, so do not use it to suggest recommended overrides — put those in the
# README instead.

# Required
OPENROUTER_API_KEY=

# Optional - model selection (defaults shown)
OPENROUTER_PRIMARY_REVIEWER_MODEL=google/gemma-4-31b-it
# Set to 0 to disable the Secondary reviewer (Primary-only mode).
OPENROUTER_SECONDARY_REVIEWER_MODEL=minimax/minimax-m2.7

# Optional - OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# Optional - timeouts and limits
OPENROUTER_REVIEWER_TIMEOUT_SECONDS=300
# Must be strictly greater than OPENROUTER_REVIEWER_TIMEOUT_SECONDS; equal values are
# rejected at startup. Defaults to the reviewer timeout + 60s.
OPENROUTER_TOOL_CALL_TIMEOUT_SECONDS=360
OPENROUTER_MAX_CONCURRENT_REQUESTS=4

# Optional - token budgeting
OPENROUTER_FIXED_OUTPUT_TOKENS=8192
OPENROUTER_CONTEXT_OVERHEAD_TOKENS=2000
OPENROUTER_MODEL_METADATA_TTL_SECONDS=3600

# Optional - behavior
OPENROUTER_MAX_INPUT_CHARS=100000
OPENROUTER_INCLUDE_REASONING=false

# Optional - intermittent (partial) review snapshots. Set INTERMITTENT_REVIEW_CALLS=0
# to disable the side calls entirely.
INTERMITTENT_REVIEW_CALLS=2
INTERMITTENT_MAX_OUTPUT_TOKENS=1500

# Optional - direct provider endpoints (bypass OpenRouter; fall back to it on failure)
ZAI_CODING_PLAN_KEY=
KIMI_CODE_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_API_KEY=

# Optional - Serena tool-loop limits
LAD_SERENA_MAX_TOOL_CALLS=32
LAD_SERENA_TOOL_TIMEOUT_SECONDS=30
LAD_SERENA_MAX_TOOL_RESULT_CHARS=12000
LAD_SERENA_MAX_TOTAL_CHARS=100000
LAD_SERENA_MAX_DIR_ENTRIES=100
LAD_SERENA_MAX_SEARCH_RESULTS=20
